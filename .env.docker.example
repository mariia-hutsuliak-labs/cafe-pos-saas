# Шаблон для Docker. Скопіюй у .env: cp .env.docker.example .env
APP_ENV=sandbox
DEBUG=false
SECRET_KEY=replace-with-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL у контейнері db. Пароль без символів @ : / # ?
POSTGRES_USER=cafe_pos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cafe_pos_docker

# Порт на комп'ютері, куди відкривається застосунок
WEB_PORT=8000
